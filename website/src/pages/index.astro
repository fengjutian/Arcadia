---
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilities, workflow } from '../lib/site';
import { getCollection } from 'astro:content';
const products = await getCollection('products', ({data}) => data.featured);
---
<BaseLayout>
  <section class="hero-section relative overflow-hidden border-b border-[var(--line)]">
    <div class="absolute inset-0 grid-lines opacity-25 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <div class="shell hero-shell relative grid items-center gap-12 py-16 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(480px,.9fr)] lg:gap-16 lg:py-24">
      <div class="hero-copy">
        <p class="eyebrow">Arcadia 0.6.0 · Windows desktop</p>
        <h1 class="display hero-title mt-7"><span>浏览之后，</span><span>留下<span class="text-[var(--acid)]">可用的</span></span><span class="text-[var(--acid)]">知识。</span></h1>
        <p class="hero-description muted mt-7 max-w-2xl text-lg">一个本地优先的桌面知识浏览器。原生多标签浏览、Reader、知识库、全文检索、引用问答与隐私控制，共用一条连续工作流。</p>
        <div class="mt-9 flex flex-wrap gap-3"><a href="/download/" class="btn btn-primary">查看 0.6.0</a><a href="/products/arcadia/" class="btn">完整功能</a></div>
        <div class="hero-meta mt-10 grid max-w-2xl grid-cols-1 gap-px bg-[var(--line)] sm:grid-cols-3"><span><b>LOCAL</b>本地 SQLite</span><span><b>AI PROVIDER</b>OpenAI / Ollama</span><span><b>EXTENSIBLE</b>WASM 插件隔离</span></div>
      </div>
      <div class="hero-preview relative mx-auto w-full max-w-[620px] border border-[var(--line)] bg-[var(--panel)] p-3 shadow-2xl shadow-black/15">
        <div class="mb-3 flex items-center gap-2 border-b border-[var(--line)] px-2 pb-3"><span class="size-2 rounded-full bg-[#ff6b62]"></span><span class="size-2 rounded-full bg-[#ffc952]"></span><span class="size-2 rounded-full bg-[var(--acid)]"></span><span class="ml-3 flex-1 bg-[var(--subtle)] px-3 py-1 text-xs muted">arcadia / reader</span></div>
        <div class="grid min-h-[440px] grid-cols-[72px_1fr]"><div class="border-r border-[var(--line)] pt-5 text-center text-xs muted"><img src="/favicon.svg" width="38" height="38" alt="" class="mx-auto mb-7"/><div class="space-y-6"><div>▣</div><div>⌕</div><div>◇</div><div>✦</div></div></div><div class="p-7 md:p-9"><p class="text-xs text-[var(--acid)]">READER MODE</p><h2 class="mt-4 text-3xl font-semibold leading-tight tracking-tight md:text-4xl">从当前网页，进入你的本地知识库</h2><div class="mt-8 space-y-3"><div class="h-2 w-full bg-[var(--skeleton)]"></div><div class="h-2 w-11/12 bg-[var(--skeleton)]"></div><div class="h-2 w-4/5 bg-[var(--skeleton)]"></div></div><div class="mt-9 border-l-2 border-[var(--acid)] bg-[var(--subtle)] p-5"><p class="text-xs muted">AI 摘要</p><p class="mt-2 text-sm">先提取正文，再基于页面内容进行摘要、翻译或问答；保存后仍可搜索并追溯来源。</p></div><div class="mt-7 flex flex-wrap gap-2"><span class="border border-[var(--line)] px-3 py-1 text-xs">保存到知识库</span><span class="border border-[var(--line)] px-3 py-1 text-xs">基于页面提问</span></div></div></div>
      </div>
    </div>
  </section>

  <section class="shell py-24 md:py-28"><div class="grid gap-10 lg:grid-cols-[.65fr_1.35fr]"><div><p class="eyebrow">Implemented in 0.6.0</p><h2 class="section-title mt-6">不是概念图，<br/>是已经接通的功能。</h2><p class="muted mt-6 max-w-sm">当前版本已越过早期原型阶段。下面的能力均对应仓库中的实际实现。</p></div><div class="grid sm:grid-cols-2">{capabilities.map((item,i)=><article class:list={["min-h-72 border-[var(--line)] p-7", i%2===0?"sm:border-r":"", i<2?"border-b":""]}><span class="text-sm text-[var(--acid)]">{item.no}</span><h3 class="mt-12 text-2xl font-semibold">{item.title}</h3><p class="muted mt-3">{item.body}</p></article>)}</div></div></section>

  <section class="border-y border-[var(--line)] bg-[var(--panel)] py-20"><div class="shell"><p class="eyebrow">One continuous loop</p><h2 class="section-title mt-6 max-w-4xl">从打开网页，到再次使用。</h2><div class="mt-12 grid gap-px bg-[var(--line)] md:grid-cols-4">{workflow.map((item,index)=><article class="bg-[var(--bg)] p-7"><span class="text-xs text-[var(--acid)]">0{index+1}</span><h3 class="mt-10 text-2xl font-semibold">{item.step}</h3><p class="muted mt-3 text-sm">{item.detail}</p></article>)}</div></div></section>

  <section class="bg-[var(--acid)] py-20 text-[#11150f]"><div class="shell grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end"><div><p class="text-sm font-bold uppercase tracking-[.16em]">Local-first by design</p><h2 class="mt-4 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-[-.04em] md:text-7xl">知识库留在设备上，<br/>AI 服务由你选择。</h2><p class="mt-6 max-w-2xl text-lg">浏览数据与知识库默认保存在本地；Provider 可配置，密钥进入系统密钥环。Windows 版本还提供请求拦截与站点权限控制。</p></div><a href="/privacy/" class="btn border-[#11150f]">了解隐私边界</a></div></section>

  <section class="shell py-24 md:py-28"><div class="flex flex-wrap items-end justify-between gap-6"><div><p class="eyebrow">Current build</p><h2 class="section-title mt-6">Arcadia 0.6.0</h2></div><a href="/products/" class="text-sm text-[var(--acid)]">查看产品中心 →</a></div>{products.map(p=><a href={`/products/${p.id}/`} class="mt-12 grid gap-10 border border-[var(--line)] bg-[var(--panel)] p-8 transition hover:border-[var(--acid)] md:grid-cols-[1fr_auto] md:items-end"><div><span class="text-xs uppercase tracking-[.16em] muted">{p.data.category} · v{p.data.version} · {p.data.platforms.join(' / ')}</span><h3 class="mt-3 text-5xl font-semibold tracking-[-.04em]">{p.data.title}</h3><p class="muted mt-4 max-w-2xl text-lg">{p.data.description}</p></div><span class="btn btn-primary">查看已实现功能</span></a>)}</section>
</BaseLayout>
