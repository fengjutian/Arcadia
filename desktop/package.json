{
  "name": "ai-knowledge-browser-desktop",
  "private": true,
  "version": "0.5.0",
  "packageManager": "npm@11.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:msi": "tauri build --bundles msi",
    "tauri:build:exe": "tauri build --bundles nsis",
